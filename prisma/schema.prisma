// ──────────────────────────────────────────────
// Musinsa MVP – Prisma Schema
// 크롤링 기반 멀티브랜드 패션 이커머스
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════
// 1. USER & AUTH
// ═══════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  nickname      String?   @unique
  passwordHash  String?
  phone         String?
  gender        Gender?
  birthDate     DateTime?
  profileImage  String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  approvedAt    DateTime? // 승인제: null=승인 대기, 값 있으면 승인 완료. 미승인 회원은 로그인 불가(ADMIN 예외)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  coupons       UserCoupon[]
  points        PointHistory[]
  inquiries     ProductInquiry[]
  returnRequests       ReturnRequest[]
  snapLikes            SnapLike[]
  snapComments         SnapComment[]
  releaseSubscriptions ReleaseSubscription[]
  brandFollows         BrandFollow[]
  repairRequests       RepairRequest[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("집") // 집, 회사, etc.
  recipient String
  phone     String
  zipCode   String
  address1  String // 기본 주소
  address2  String? // 상세 주소
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ═══════════════════════════════════════════════
// 2. BRAND & CATEGORY
// ═══════════════════════════════════════════════

model Brand {
  id            String   @id @default(cuid())
  name          String   @unique
  nameKo        String? // 한글명
  slug          String   @unique
  logoUrl       String?
  description   String?  @db.Text
  coverImageUrl String? // 브랜드관 상단 커버 이미지
  isActive      Boolean  @default(true)
  followerCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products       Product[]
  followers      BrandFollow[]
  lookbooks      Lookbook[]
  campaigns      BrandCampaign[]

  @@map("brands")
}

// ── 브랜드 팔로우 (좋아하는 브랜드 하트) ──
model BrandFollow {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId])
  @@map("brand_follows")
}

// ── 브랜드관 캠페인 ──
model BrandCampaign {
  id          String   @id @default(cuid())
  brandId     String
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@map("brand_campaigns")
}

model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  iconUrl   String?
  depth     Int     @default(0) // 0: 대분류, 1: 중분류, 2: 소분류
  sortOrder Int     @default(0)
  parentId  String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

// ═══════════════════════════════════════════════
// 3. PRODUCT (크롤링 데이터 저장 핵심)
// ═══════════════════════════════════════════════

model Product {
  id            String        @id @default(cuid())
  brandId       String
  categoryId    String
  name          String
  slug          String        @unique
  description   String?       @db.Text
  originalPrice Int // 원가
  salePrice     Int? // 할인가 (null이면 할인 없음)
  status        ProductStatus @default(DRAFT)
  isNew         Boolean       @default(false)
  isBest        Boolean       @default(false)
  isGift        Boolean       @default(false) // GIFTS 큐레이션용
  isOutlet      Boolean       @default(false) // 아울렛 큐레이션용
  viewCount     Int           @default(0)
  reviewCount   Int           @default(0)
  reviewAvg     Float         @default(0)
  rankPosition  Int? // 랭킹 순위
  dealStartsAt  DateTime? // 타임딜 시작
  dealEndsAt    DateTime? // 타임딜 종료
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // 크롤링 메타데이터
  sourceUrl       String? // 원본 상품 URL
  sourceSite      String? // 크롤링 출처 (무신사, 29cm 등)
  sourceProductId String? // 원본 사이트의 상품 ID (sourceSite + sourceProductId 로 식별)
  contentHash     String? // 가격+품절+옵션 해시 (재크롤 변경감지: 동일 시 skip)
  crawledAt       DateTime? // 크롤링 시점
  crawlJobId      String? // 어떤 크롤링 작업으로 수집됐는지

  brand         Brand            @relation(fields: [brandId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inquiries     ProductInquiry[]
  tags          ProductTag[]
  eventProducts EventProduct[]
  lookbookProducts LookbookProduct[]
  priceHistory  PriceHistory[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([rankPosition])
  @@index([sourceUrl])
  @@index([sourceSite, sourceProductId])
  @@index([isGift])
  @@index([isOutlet])
  @@index([dealEndsAt])
  @@map("products")
}

enum ProductStatus {
  DRAFT // 크롤링 후 검수 대기
  ACTIVE // 판매중
  SOLDOUT // 품절
  HIDDEN // 비노출
  ARCHIVED // 삭제(보관)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  color     String?
  size      String?
  sku       String? @unique
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

model ProductTag {
  id        String @id @default(cuid())
  productId String
  tag       String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag])
  @@index([tag])
  @@map("product_tags")
}

// ═══════════════════════════════════════════════
// 4. CRAWL JOB (크롤링 작업 관리)
// ═══════════════════════════════════════════════

model CrawlJob {
  id           String      @id @default(cuid())
  sourceSite   String // "musinsa", "29cm", etc.
  targetUrl    String? // 크롤링 대상 URL
  status       CrawlStatus @default(PENDING)
  totalItems   Int         @default(0)
  successItems Int         @default(0)
  failedItems  Int         @default(0)
  errorLog     String?     @db.Text
  warning      String? // 알림: 수집 0건/전일대비 급감 등 경고 플래그
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  @@index([status])
  @@index([sourceSite])
  @@map("crawl_jobs")
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ═══════════════════════════════════════════════
// 5. ORDER & PAYMENT
// ═══════════════════════════════════════════════

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // ORD-20260402-XXXXX
  userId         String
  addressId      String?
  status         OrderStatus @default(PENDING)
  totalAmount    Int
  discountAmount Int         @default(0)
  shippingFee    Int         @default(0)
  finalAmount    Int // totalAmount - discountAmount + shippingFee
  paymentMethod  String?
  paidAt         DateTime?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  couponId        String?
  trackingNumber  String?
  trackingCarrier String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  reconcileNote   String?   @db.Text // 관리자 확인 필요 사유(자동 정리가 감지한 결제/주문 불일치 등). 고객용 note 와 분리.

  user    User        @relation(fields: [userId], references: [id])
  address Address?    @relation(fields: [addressId], references: [id])
  coupon  Coupon?     @relation(fields: [couponId], references: [id])
  items   OrderItem[]
  payment Payment?
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  PENDING // 주문 접수
  PAID // 결제 완료
  PREPARING // 상품 준비중
  SHIPPED // 배송중
  DELIVERED // 배송 완료
  CANCELLED // 주문 취소
  RETURN_REQUESTED // 반품 요청
  RETURNED // 반품 완료
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  productName String // 주문 당시 상품명 스냅샷
  brandName   String // 주문 당시 브랜드명 스냅샷
  imageUrl    String? // 주문 당시 상품 이미지 스냅샷
  color       String?
  size        String?
  quantity    Int
  unitPrice   Int
  totalPrice  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  method        PaymentMethod
  amount        Int
  status        PaymentStatus @default(PENDING)
  transactionId String? // PG사 거래 ID
  pgCurrency    String? // 실제 PG 결제 통화 (예: "CNY")
  pgAmount      Decimal?      @db.Decimal(18, 2) // 외화 결제 금액 (예: 10339.42) — 환불 시 이 값 사용
  fxRate        Decimal?      @db.Decimal(18, 4) // 적용 환율 (1 CNY 당 KRW, 예: 190)
  pgRaw         String?       @db.Text // 결제 노티 원본 payload (디버그 + 환불 거래번호 추출용)
  refundRaw     String?       @db.Text // 환불(refund.icb) 응답 원본 (디버그)
  paidAt        DateTime?
  cancelledAt   DateTime?
  refundedAt    DateTime? // 실제 환불(refund.icb) 성공 확정 시각. 이 값이 있어야만 "환불됨"으로 신뢰 (상태만 REFUNDED/CANCELLED 인 것은 크래시로 인한 미확정일 수 있음)
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  KAKAO_PAY
  NAVER_PAY
  TOSS_PAY
  ALIPAY // Funpay (ICB) — 알리페이 (중국)
  WECHAT_PAY // Funpay (ICB) — 위챗페이 (중국)
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// ═══════════════════════════════════════════════
// 6. CART & WISHLIST
// ═══════════════════════════════════════════════

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, productId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ═══════════════════════════════════════════════
// 7. REVIEW & INQUIRY
// ═══════════════════════════════════════════════

model Review {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  rating       Int // 1~5
  content      String   @db.Text
  imageUrls    String[] // 리뷰 이미지
  isVerified   Boolean  @default(false) // 구매 인증 리뷰
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId, rating])
  @@map("reviews")
}

model ProductInquiry {
  id         String    @id @default(cuid())
  userId     String
  productId  String
  title      String
  content    String    @db.Text
  isSecret   Boolean   @default(false)
  answer     String?   @db.Text
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("product_inquiries")
}

// ═══════════════════════════════════════════════
// 8. COUPON & POINT
// ═══════════════════════════════════════════════

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  name           String
  description    String?
  discountType   DiscountType
  discountValue  Int // 퍼센트(%) 또는 금액(원)
  minOrderAmount Int? // 최소 주문금액
  maxDiscount    Int? // 최대 할인금액
  totalQuantity  Int? // 전체 발급 수량
  usedCount      Int          @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  userCoupons UserCoupon[]
  orders      Order[]

  @@map("coupons")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model UserCoupon {
  id       String    @id @default(cuid())
  userId   String
  couponId String
  usedAt   DateTime?
  issuedAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
  @@map("user_coupons")
}

model PointHistory {
  id          String    @id @default(cuid())
  userId      String
  amount      Int // 양수: 적립, 음수: 사용
  balance     Int // 변동 후 잔액
  type        PointType
  description String
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("point_history")
}

enum PointType {
  EARN_PURCHASE // 구매 적립
  EARN_REVIEW // 리뷰 적립
  EARN_EVENT // 이벤트 적립
  USE_ORDER // 주문 사용
  EXPIRE // 만료
  ADMIN_ADJUST // 관리자 조정
}

// ═══════════════════════════════════════════════
// 9. CONTENT (매거진, 스냅, 배너)
// ═══════════════════════════════════════════════

model Banner {
  id             String    @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  imageAlignment String    @default("left") // "left" | "right" — 모델 위치, 반대쪽에 텍스트 배치
  linkUrl        String?
  position       String    @default("HOME_MAIN") // HOME_MAIN, HOME_SUB, CATEGORY
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())

  @@map("banners")
}

model Magazine {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String
  author      String?
  tags        String[]
  viewCount   Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("magazines")
}

model Snap {
  id           String   @id @default(cuid())
  imageUrl     String
  caption      String?
  authorName   String
  authorImage  String?
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  likes    SnapLike[]
  comments SnapComment[]

  @@map("snaps")
}

// ═══════════════════════════════════════════════
// 10. RELEASE CALENDAR
// ═══════════════════════════════════════════════

model Release {
  id          String        @id @default(cuid())
  productName String
  brandName   String
  imageUrl    String
  releaseDate DateTime
  price       Int?
  description String?       @db.Text
  status      ReleaseStatus @default(UPCOMING)
  notifyCount Int           @default(0)
  createdAt   DateTime      @default(now())

  subscriptions ReleaseSubscription[]

  @@index([releaseDate])
  @@map("releases")
}

enum ReleaseStatus {
  UPCOMING
  RELEASED
  SOLDOUT
}

// ═══════════════════════════════════════════════
// 11. RETURN REQUESTS
// ═══════════════════════════════════════════════

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  reason      String
  description String?      @db.Text
  imageUrls   String[]
  status      ReturnStatus @default(PENDING)
  refundAmount Int?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("return_requests")
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ═══════════════════════════════════════════════
// 12. SNAP SOCIAL
// ═══════════════════════════════════════════════

model SnapLike {
  id      String   @id @default(cuid())
  snapId  String
  userId  String
  createdAt DateTime @default(now())

  snap Snap @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([snapId, userId])
  @@map("snap_likes")
}

model SnapComment {
  id      String   @id @default(cuid())
  snapId  String
  userId  String
  content String   @db.Text
  createdAt DateTime @default(now())

  snap Snap @relation(fields: [snapId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("snap_comments")
}

// ═══════════════════════════════════════════════
// 13. RELEASE SUBSCRIPTIONS
// ═══════════════════════════════════════════════

model ReleaseSubscription {
  id        String   @id @default(cuid())
  releaseId String
  userId    String
  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([releaseId, userId])
  @@map("release_subscriptions")
}

// ═══════════════════════════════════════════════
// 14. EVENTS (기획전 / 편집형 프로모션)
// ═══════════════════════════════════════════════

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  subtitle    String?
  description String?  @db.Text
  coverImage  String
  bannerImage String?
  startsAt    DateTime?
  endsAt      DateTime?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products EventProduct[]

  @@index([isPublished])
  @@index([endsAt])
  @@map("events")
}

model EventProduct {
  id        String @id @default(cuid())
  eventId   String
  productId String
  sortOrder Int    @default(0)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([eventId, productId])
  @@map("event_products")
}

// ═══════════════════════════════════════════════
// 15. LOOKBOOK (코디네이션)
// ═══════════════════════════════════════════════

model Lookbook {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  subtitle    String?
  season      String? // 2026 S/S 등
  gender      String? // MEN, WOMEN, UNISEX
  coverImage  String
  description String?  @db.Text
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  viewCount   Int      @default(0)
  brandId     String?
  kind        String? // null=일반 룩북, "OUTFIT"=추천 코디(의상 조합)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand?             @relation(fields: [brandId], references: [id])
  products LookbookProduct[]
  images   LookbookImage[]

  @@index([isPublished])
  @@index([gender])
  @@index([brandId])
  @@map("lookbooks")
}

model LookbookImage {
  id         String @id @default(cuid())
  lookbookId String
  url        String
  caption    String?
  sortOrder  Int    @default(0)

  lookbook Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)

  @@index([lookbookId])
  @@map("lookbook_images")
}

model LookbookProduct {
  id         String @id @default(cuid())
  lookbookId String
  productId  String
  sortOrder  Int    @default(0)
  role       String? // 코디 슬롯 라벨: "TOP" | "BOTTOM" | "OUTER" | "SHOES" | "ACC"

  lookbook Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([lookbookId, productId])
  @@map("lookbook_products")
}

// ═══════════════════════════════════════════════
// 16. REPAIR REQUEST (수선 신청/진행조회)
// ═══════════════════════════════════════════════

model RepairRequest {
  id             String             @id @default(cuid())
  requestNumber  String             @unique // RPxxxxx
  userId         String
  orderNumber    String? // 관련 주문번호
  productName    String // 상품명 (스냅샷)
  brandName      String? // 브랜드명 (스냅샷)
  issue          String             @db.Text // 수선 요청 내용
  imageUrls      String[] // 문제 부위 이미지
  status         RepairStatus       @default(RECEIVED)
  estimatedCost  Int? // 예상 비용
  finalCost      Int? // 실제 청구 비용
  pickupAddress  String? // 수거 주소
  deliveryCarrier String? // 반송 택배사
  deliveryNumber String? // 반송 송장번호
  adminNote      String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("repair_requests")
}

enum RepairStatus {
  RECEIVED // 접수
  INSPECTING // 검수중
  QUOTED // 견적 발송
  IN_PROGRESS // 수선중
  SHIPPING // 반송중
  COMPLETED // 완료
  CANCELLED // 취소/반려
}

// 크롤 재수집 시 가격/품절 변경 이력 (변경감지가 update로 판정한 순간 기록)
model PriceHistory {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice       Int // 이전 정가
  newPrice       Int // 신규 정가
  oldSalePrice   Int? // 이전 할인가
  newSalePrice   Int? // 신규 할인가
  soldOutChanged Boolean  @default(false) // 품절 상태 변동 여부
  createdAt      DateTime @default(now()) // 변경 감지 시각

  @@index([productId])
  @@index([createdAt])
}
