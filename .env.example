DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://your-domain.up.railway.app"
NEXTAUTH_URL="https://your-domain.up.railway.app"

# 관리자 운영 API (/api/admin/*) 보호 토큰
# 생성: openssl rand -hex 32 (64자 hex, >=16자 필수)
# 절대 클라이언트에 노출하지 말 것 (NEXT_PUBLIC_ 금지)
ADMIN_OPS_TOKEN=

# (Optional) Kakao Login
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# (Optional) Naver Login
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# PortOne (아임포트) V2 PG 결제 — (보조 PG, 한국 카드용. 현재 미사용)
NEXT_PUBLIC_PORTONE_STORE_ID=imp00000000
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# ─────────────────────────────────────────────
# Funpay (ICB Online Payment) — 알리페이/위챗페이 (중국 결제)
# 영업/기업부설연구소(develop@icbnet.co.kr)에서 계약 후 발급
# ─────────────────────────────────────────────
# 가맹점 ID (예: P00000000000)
FUNPAY_MID=
# 위·변조 방지 fgkey 생성용 비밀키 (절대 노출 금지, NEXT_PUBLIC_ 금지)
FUNPAY_SECRET_KEY=
# API base — 테스트: https://onlinetest.funpay.co.kr / 운영: 영업 전달값
FUNPAY_API_BASE="https://onlinetest.funpay.co.kr"
# 결제수단 원천사 서비스타입 (영업이 결제수단별 코드 전달, 기본 S000)
FUNPAY_SERVICE_TYPE="S000"
# returnurl/statusurl 절대경로 조립용 (배포 도메인)
NEXT_PUBLIC_BASE_URL="https://nia-international-platform-production.up.railway.app"
