DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://your-domain.up.railway.app"
NEXTAUTH_URL="https://your-domain.up.railway.app"

# (Optional) Kakao Login
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# (Optional) Naver Login
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# ─── PortOne (아임포트) V2 PG 결제 ───
# PortOne 콘솔(https://admin.portone.io)에서 발급
# 클라이언트 번들에 포함되는 공개 값
NEXT_PUBLIC_PORTONE_STORE_ID=imp00000000
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 서버 전용 시크릿 — 절대 클라이언트에 노출 금지
PORTONE_API_SECRET=
# webhook HMAC-SHA256 서명 검증용 (PortOne 콘솔의 webhook 등록 시 발급)
PORTONE_WEBHOOK_SECRET=

# 결제 테스트 모드 (PortOne 호출 생략, 본인 주문/금액만 검증)
# production에서는 반드시 false 또는 미설정
NEXT_PUBLIC_PAYMENT_TEST_MODE=true

# ─── 어드민 부트스트랩 ───
# /api/admin/setup 엔드포인트 호출 시 필요한 1회용 토큰
# 부트스트랩 완료 후 Railway 환경변수에서 제거 권장
ADMIN_SETUP_TOKEN=

# ─── Rate Limiting (선택) ───
# Upstash Redis REST 엔드포인트 (미설정 시 in-memory 폴백)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
