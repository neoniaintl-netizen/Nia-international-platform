DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://your-domain.up.railway.app"
NEXTAUTH_URL="https://your-domain.up.railway.app"

# 관리자 운영 API (/api/admin/*) 보호 토큰
# 생성: openssl rand -hex 32 (64자 hex, >=16자 필수)
# 절대 클라이언트에 노출하지 말 것 (NEXT_PUBLIC_ 금지)
ADMIN_OPS_TOKEN=

# (Optional) Kakao Login
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# (Optional) Naver Login
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# PortOne (아임포트) V2 PG 결제
# PortOne 콘솔(https://admin.portone.io)에서 발급
NEXT_PUBLIC_PORTONE_STORE_ID=imp00000000
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
